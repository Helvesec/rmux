{
  "schema": 1,
  "purpose": "L6-041 focused registry geometry and contextual discovery; primary tmux3.7b semantics frozen before edits",
  "steps": [
    {
      "kind": "observe",
      "id": "absent-xyz",
      "argv": [
        "display-message",
        "-p",
        "#{pane_x}|#{pane_y}|#{pane_z}"
      ],
      "success": {
        "exit": 0,
        "stderr": ""
      },
      "expected_stdout": "||\n"
    },
    {
      "kind": "observe",
      "id": "absent-discovery",
      "argv": [
        "display-message",
        "-a"
      ],
      "success": {
        "exit": 0,
        "stderr": ""
      }
    },
    {
      "kind": "command",
      "argv": [
        "new-session",
        "-d",
        "-s",
        "alpha",
        "-n",
        "geometry",
        "-x",
        "80",
        "-y",
        "24",
        "/bin/bash",
        "--noprofile",
        "--norc",
        "-c",
        "printf '%s\\n' \"$$\" > @ROOT@/main.pid; while IFS= read -r line; do printf 'RX:%s\\n' \"$line\"; done"
      ],
      "helper": "main"
    },
    {
      "kind": "observe",
      "id": "single-xyz",
      "argv": [
        "display-message",
        "-p",
        "-t",
        "alpha:0.0",
        "#{pane_x}|#{pane_y}|#{pane_z}"
      ],
      "success": {
        "exit": 0,
        "stderr": ""
      },
      "expected_stdout": "0|0|1\n"
    },
    {
      "kind": "observe",
      "id": "tiled-discovery",
      "argv": [
        "display-message",
        "-a",
        "-t",
        "alpha:0.0"
      ],
      "success": {
        "exit": 0,
        "stderr": ""
      }
    },
    {
      "kind": "command",
      "argv": [
        "split-window",
        "-d",
        "-h",
        "-l",
        "20",
        "-t",
        "alpha:0.0",
        "/bin/bash",
        "--noprofile",
        "--norc",
        "-c",
        "printf '%s\\n' \"$$\" > @ROOT@/other.pid; while IFS= read -r line; do printf 'RX:%s\\n' \"$line\"; done"
      ],
      "helper": "other"
    },
    {
      "kind": "observe",
      "id": "tiled-list",
      "argv": [
        "list-panes",
        "-t",
        "alpha:0",
        "-F",
        "#{pane_index}|#{pane_x}|#{pane_y}|#{pane_z}"
      ],
      "success": {
        "exit": 0,
        "stderr": ""
      },
      "expected_stdout": "0|0|0|1\n1|60|0|1\n"
    },
    {
      "kind": "command",
      "argv": [
        "new-pane",
        "-d",
        "-t",
        "alpha:0.0",
        "-x",
        "12",
        "-y",
        "5",
        "-X",
        "-3",
        "-Y",
        "-2",
        "/bin/bash",
        "--noprofile",
        "--norc",
        "-c",
        "printf '%s\\n' \"$$\" > @ROOT@/floatback.pid; while IFS= read -r line; do printf 'RX:%s\\n' \"$line\"; done"
      ],
      "helper": "floatback"
    },
    {
      "kind": "observe",
      "id": "negative-float-xyz",
      "argv": [
        "display-message",
        "-p",
        "-t",
        "alpha:0.2",
        "#{pane_x}|#{pane_y}|#{pane_z}"
      ],
      "success": {
        "exit": 0,
        "stderr": ""
      },
      "expected_stdout": "-3|-2|0\n"
    },
    {
      "kind": "observe",
      "id": "one-float-tiled-z",
      "argv": [
        "display-message",
        "-p",
        "-t",
        "alpha:0.0",
        "#{pane_z}"
      ],
      "success": {
        "exit": 0,
        "stderr": ""
      },
      "expected_stdout": "2\n"
    },
    {
      "kind": "observe",
      "id": "float-discovery",
      "argv": [
        "display-message",
        "-a",
        "-t",
        "alpha:0.2"
      ],
      "success": {
        "exit": 0,
        "stderr": ""
      }
    },
    {
      "kind": "command",
      "argv": [
        "new-pane",
        "-d",
        "-t",
        "alpha:0.0",
        "-x",
        "10",
        "-y",
        "4",
        "-X",
        "7",
        "-Y",
        "3",
        "/bin/bash",
        "--noprofile",
        "--norc",
        "-c",
        "printf '%s\\n' \"$$\" > @ROOT@/floatfront.pid; while IFS= read -r line; do printf 'RX:%s\\n' \"$line\"; done"
      ],
      "helper": "floatfront"
    },
    {
      "kind": "observe",
      "id": "two-floats-list",
      "argv": [
        "list-panes",
        "-t",
        "alpha:0",
        "-F",
        "#{pane_index}|#{pane_x}|#{pane_y}|#{pane_z}"
      ],
      "success": {
        "exit": 0,
        "stderr": ""
      },
      "expected_stdout": "0|0|0|3\n1|60|0|3\n2|-3|-2|1\n3|7|3|0\n"
    },
    {
      "kind": "command",
      "argv": [
        "select-pane",
        "-t",
        "alpha:0.2"
      ]
    },
    {
      "kind": "observe",
      "id": "raised-float-list",
      "argv": [
        "list-panes",
        "-t",
        "alpha:0",
        "-F",
        "#{pane_index}|#{pane_x}|#{pane_y}|#{pane_z}"
      ],
      "success": {
        "exit": 0,
        "stderr": ""
      },
      "expected_stdout": "0|0|0|3\n1|60|0|3\n2|-3|-2|0\n3|7|3|1\n"
    },
    {
      "kind": "observe",
      "id": "position-aliases",
      "argv": [
        "display-message",
        "-p",
        "-t",
        "alpha:0.2",
        "#{pane_x}|#{pane_left}|#{pane_y}|#{pane_top}|#{pane_width}|#{pane_height}|#{pane_right}|#{pane_bottom}"
      ],
      "success": {
        "exit": 0,
        "stderr": ""
      },
      "expected_stdout": "-3|-3|-2|-2|12|5|8|2\n"
    },
    {
      "kind": "observe",
      "id": "siblings",
      "argv": [
        "display-message",
        "-p",
        "-t",
        "alpha:0.2",
        "#{?pane_floating_flag,F,T}|#{==:#{pane_x},-3}|tail#|##|#{pane_z}"
      ],
      "success": {
        "exit": 0,
        "stderr": ""
      },
      "expected_stdout": "F|1|tail#|#|0\n"
    }
  ]
}
