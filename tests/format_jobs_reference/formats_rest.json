{
  "schema": 1,
  "name": "formats-rest-linux-v1",
  "independent_expectation": "Exact tmux3.7b raw outputs frozen before candidate, selected from pinned format.c/window-copy.c semantics. No candidate values as oracle.",
  "startup": "set-option -s exit-empty off\nset-option -g status off\nset-option -g automatic-rename off\nset-option -g mode-keys vi\nnew-session -d -s alpha -n zeta -x 40 -y 16 /bin/bash --noprofile --norc -c 'printf '\"'\"'%s\\n'\"'\"' \"$$\" > @ROOT@/main.pid; IFS= read -r first; printf '\"'\"'\\033[H\\033[2J'\"'\"'; printf '\"'\"'%b'\"'\"' '\"'\"'T\\tTAB tail\\r\\nababa tail\\r\\nxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxEND\\r\\nNEXT tail\\r\\nwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwWRAPEND tail\\r\\nREADY038\\r\\n'\"'\"'; printf '\"'\"'RX:%s\\n'\"'\"' \"$first\"; while IFS= read -r line; do printf '\"'\"'RX:%s\\n'\"'\"' \"$line\"; done'\nsend-keys -F -t alpha:0.0 'startup:#{session_name}:#{pane_index}' Enter\n",
  "startup_helpers": [
    "main"
  ],
