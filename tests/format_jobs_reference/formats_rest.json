        "-d",
        "-s",
        "beta",
        "-n",
        "beta",
        "-x",
        "40",
        "-y",
        "16",
        "/bin/bash",
        "--noprofile",
        "--norc",
        "-c",
        "printf '%s\\n' \"$$\" > @ROOT@/other.pid; printf '%b' 'READY038\\r\\n'; while IFS= read -r line; do printf 'RX:%s\\n' \"$line\"; done"
      ],
      "helper": "other"
    },
    {
